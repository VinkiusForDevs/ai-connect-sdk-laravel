{
    "name": "vinkius/ai-connect-sdk-laravel",
    "description": "Laravel integration for @vinkius/connect. Give every user of your AI app their own connectors and capabilities.",
    "license": "Apache-2.0",
    "type": "library",
    "keywords": [
        "laravel",
        "vinkius",
        "connect",
        "ai",
        "agents",
        "tools",
        "function-calling",
        "connectors",
        "capabilities",
        "openai",
        "anthropic",
        "gemini"
    ],
    "authors": [
        {
            "name": "Vinkius",
            "email": "dev@vinkius.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.4|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vinkius\\ConnectLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vinkius\\ConnectLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vinkius\\ConnectLaravel\\VinkiusServiceProvider"
            ],
            "aliases": {
                "Vinkius": "Vinkius\\ConnectLaravel\\Facades\\Vinkius"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
